// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("OPERATIONS")
  department   String?
  phone        String?
  avatar       String?
  status       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id               String     @id @default(cuid())
  name             String
  contactNo        String
  email            String     @unique
  address          String
  company          String?
  registrationDate DateTime   @default(now())
  shipments        Shipment[]
  invoices         Invoice[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model Route {
  id            String    @id @default(cuid())
  routeId       String    @unique
  startHub      String
  endHub        String
  estimatedDays Float
  isActive      Boolean   @default(true)
  shipments     Shipment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Vehicle {
  id          String    @id @default(cuid())
  vehicleId   String    @unique
  type        String
  capacity    Float
  status      String    @default("Available")
  description String?
  shipments   Shipment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Shipment {
  id             String          @id @default(cuid())
  shipmentCode   String          @unique
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id])
  routeId        String?
  route          Route?          @relation(fields: [routeId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?        @relation(fields: [vehicleId], references: [id])
  senderName     String
  senderContact  String
  senderAddress  String
  consigneeName  String
  consigneeContact String
  consigneeAddress String
  origin         String
  destination    String
  weight         Float
  description    String?
  dimensions     String?
  shippingMethod String?
  expectedDeliveryDate DateTime?
  status         String          @default("PENDING")
  dispatchDate   DateTime?
  deliveryDate   DateTime?
  archivedAt     DateTime?
  trackingEvents TrackingEvent[]
  warehouseItems WarehouseItem[]
  invoices       Invoice[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model TrackingEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  location    String
  status      String
  description String
  timestamp   DateTime @default(now())
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNo     String    @unique
  shipmentId    String
  shipment      Shipment  @relation(fields: [shipmentId], references: [id])
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  totalAmount   Float
  tax           Float     @default(0)
  paymentStatus String    @default("PENDING")
  paymentMethod String?
  notes         String?
  date          DateTime  @default(now())
  payments      Payment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Payment {
  id            String   @id @default(cuid())
  paymentNo     String   @unique
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amount        Float
  method        String   @default("BANK_TRANSFER")
  status        String   @default("COMPLETED")
  reference     String?
  notes         String?
  paidBy        String?
  paymentDate   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  expenseNo   String   @unique
  category    String
  title       String
  description String?
  amount      Float
  status      String   @default("PENDING")
  paymentMethod String?
  vendor      String?
  incurredBy  String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WarehouseItem {
  id                String   @id @default(cuid())
  shipmentId        String
  shipment          Shipment @relation(fields: [shipmentId], references: [id])
  warehouseLocation String
  storageDate       DateTime @default(now())
  status            String   @default("SAFE")
  barcodeQR         String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InventoryItem {
  id          String   @id @default(cuid())
  itemCode    String   @unique
  name        String
  category    String
  quantity    Int      @default(0)
  location    String
  weight      Float    @default(0)
  weightUnit  String   @default("kg")
  minStock    Int      @default(10)
  description String?
  status      String   @default("In Stock")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IncomingCargo {
  id              String   @id @default(cuid())
  cargoCode       String   @unique
  senderCompany   String
  origin          String
  itemName        String
  quantity        Int      @default(0)
  quantityUnit    String   @default("units")
  weight          Float    @default(0)
  weightUnit      String   @default("kg")
  progress        Int      @default(0)
  status          String   @default("In Transit")
  expectedArrival DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OutgoingCargo {
  id              String   @id @default(cuid())
  shipmentCode    String   @unique
  consignee       String
  destination     String
  itemName        String
  quantity        Int      @default(0)
  quantityUnit    String   @default("units")
  weight          Float    @default(0)
  weightUnit      String   @default("kg")
  shipDate        DateTime?
  status          String   @default("Processing")
  trackingId      String   @unique
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StorageSection {
  id            String   @id @default(cuid())
  sectionCode   String   @unique
  zone          String
  location      String
  currentItems  String?
  occupiedUnits Int      @default(0)
  capacityUnits Int
  status        String   @default("Available")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CargoIncident {
  id              String   @id @default(cuid())
  reportCode      String   @unique
  shipmentId      String
  incidentType    String
  severity        String
  reportDate      DateTime @default(now())
  location        String
  itemDescription String
  quantityAffected Int     @default(0)
  estimatedValue  Float    @default(0)
  description     String
  reportedBy      String
  status          String   @default("Under Review")
  attachmentUrl   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
